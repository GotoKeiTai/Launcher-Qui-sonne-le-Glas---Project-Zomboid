<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:GlasLauncher.App"
             x:Class="GlasLauncher.App.App"
             RequestedThemeVariant="Dark">
             <!-- Forced to Dark: the app's visual identity is a fixed dark theme, not meant to
                  follow the OS light/dark setting (a light OS theme makes unstyled Button text
                  unreadable against this app's dark backgrounds). -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GlasLauncher.App/Styles/Colors.axaml" />
                <ResourceInclude Source="avares://GlasLauncher.App/Styles/Typography.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource BgDeepBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource BarlowFont}" />
        </Style>
    </Application.Styles>
</Application>