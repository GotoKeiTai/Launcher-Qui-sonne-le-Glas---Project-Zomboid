<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GlasLauncher.App.ViewModels"
             xmlns:conv="using:GlasLauncher.App.Converters"
             x:Class="GlasLauncher.App.Views.RepairModalView"
             x:DataType="vm:RepairModalViewModel">

  <UserControl.Resources>
    <conv:RepairStepStateToBrushConverter x:Key="RepairStepStateToBrushConverter" />
    <conv:RepairStepStateToFontWeightConverter x:Key="RepairStepStateToFontWeightConverter" />
  </UserControl.Resources>

  <Border Width="480" CornerRadius="16" Padding="40,36"
          Background="{StaticResource BgPanelBrush}"
          BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
    <StackPanel Spacing="0">

      <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"
              Background="{StaticResource BgPanel2Brush}"
              BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1">
        <TextBlock Text="✳" FontSize="22" Foreground="{StaticResource GoldBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <TextBlock Text="RÉPARATION EN COURS" HorizontalAlignment="Center" Margin="0,20,0,0"
                 FontFamily="{StaticResource CinzelFont}" FontWeight="Bold" FontSize="20"
                 Foreground="{StaticResource GoldBrightBrush}" />

      <TextBlock Text="{Binding Subtitle}" HorizontalAlignment="Center" Margin="0,14,0,0" Width="380"
                 Foreground="{StaticResource InkDimBrush}" FontSize="13"
                 TextAlignment="Center" TextWrapping="Wrap" />

      <ProgressBar Minimum="0" Maximum="100" Value="{Binding PercentComplete}"
                   Height="6" CornerRadius="3" Margin="0,26,0,0"
                   Background="{StaticResource LineSoftBrush}" Foreground="{StaticResource GoldBrush}" />

      <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
        <TextBlock Text="{Binding MegabytesLabel}" Foreground="{StaticResource InkFaintBrush}" FontSize="12"
                   IsVisible="{Binding MegabytesLabel, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Grid.Column="1" Text="{Binding PercentComplete, StringFormat='{}{0} %'}"
                   Foreground="{StaticResource InkFaintBrush}" FontSize="12" />
      </Grid>

      <Border Height="1" Background="{StaticResource LineSoftBrush}" Margin="0,22,0,18" />

      <ItemsControl ItemsSource="{Binding Steps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RepairStepViewModel">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
              <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                       Fill="{Binding State, Converter={StaticResource RepairStepStateToBrushConverter}}" />
              <TextBlock Text="{Binding Name}" FontSize="13.5"
                         Foreground="{Binding State, Converter={StaticResource RepairStepStateToBrushConverter}}"
                         FontWeight="{Binding State, Converter={StaticResource RepairStepStateToFontWeightConverter}}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel IsVisible="{Binding HasError}" Spacing="14" Margin="0,18,0,0">
        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource WarnBrush}" FontSize="12"
                   TextWrapping="Wrap" TextAlignment="Center" />
        <Button Content="Fermer" Command="{Binding CloseCommand}" HorizontalAlignment="Center"
                MinWidth="148" Padding="32,14" />
      </StackPanel>

    </StackPanel>
  </Border>
</UserControl>
