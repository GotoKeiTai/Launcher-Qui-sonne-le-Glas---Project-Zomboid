<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GlasLauncher.App.ViewModels"
        x:Class="GlasLauncher.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Glas Launcher"
        Icon="avares://GlasLauncher.App/Assets/shield.ico"
        Width="1200" Height="860"
        MinWidth="960" MinHeight="640"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="{StaticResource BgDeepBrush}">

  <Panel>

    <!-- Custom titlebar + current page -->
    <DockPanel>
      <Border DockPanel.Dock="Top" Height="44" Background="{StaticResource BgPanelBrush}"
              BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1"
              PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="*,Auto" Margin="16,0,10,0">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Image Source="avares://GlasLauncher.App/Assets/shield.png" Width="30" Height="24" VerticalAlignment="Center" />
            <TextBlock Text="Glas Launcher" VerticalAlignment="Center"
                       FontFamily="{StaticResource CinzelFont}"
                       FontSize="14" Foreground="{StaticResource GoldBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Width="34" Height="30" Background="Transparent" Click="OnMinimizeClick">
              <Rectangle Width="10" Height="1.3" Fill="{Binding $parent[Button].Foreground}" />
            </Button>
            <Button Width="34" Height="30" Background="Transparent" Click="OnMaximizeClick">
              <Rectangle Width="10" Height="10" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" />
            </Button>
            <Button Width="34" Height="30" Background="Transparent" Click="OnCloseClick">
              <Path Width="10" Height="10" Stretch="Uniform" Data="M0,0 L10,10 M0,10 L10,0"
                    Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>

    <!-- Modal overlay -->
    <Panel IsVisible="{Binding CurrentModal, Converter={x:Static ObjectConverters.IsNotNull}}"
           Background="#B8040906">
      <ContentControl Content="{Binding CurrentModal}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>

    <!-- Resize grips: SystemDecorations="None" drops the native resize hit-testing that
         CanResize normally provides, so the edges/corners are recreated manually here,
         the same way the titlebar above uses BeginMoveDrag. -->
    <Grid RowDefinitions="6,*,6" ColumnDefinitions="6,*,6">
      <Border Grid.Row="0" Grid.Column="0" Background="Transparent" Cursor="TopLeftCorner"
              Tag="NorthWest" PointerPressed="OnResizeGripPointerPressed" />
      <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Cursor="SizeNorthSouth"
              Tag="North" PointerPressed="OnResizeGripPointerPressed" />
      <Border Grid.Row="0" Grid.Column="2" Background="Transparent" Cursor="TopRightCorner"
              Tag="NorthEast" PointerPressed="OnResizeGripPointerPressed" />
      <Border Grid.Row="1" Grid.Column="0" Background="Transparent" Cursor="SizeWestEast"
              Tag="West" PointerPressed="OnResizeGripPointerPressed" />
      <Border Grid.Row="1" Grid.Column="2" Background="Transparent" Cursor="SizeWestEast"
              Tag="East" PointerPressed="OnResizeGripPointerPressed" />
      <Border Grid.Row="2" Grid.Column="0" Background="Transparent" Cursor="BottomLeftCorner"
              Tag="SouthWest" PointerPressed="OnResizeGripPointerPressed" />
      <Border Grid.Row="2" Grid.Column="1" Background="Transparent" Cursor="SizeNorthSouth"
              Tag="South" PointerPressed="OnResizeGripPointerPressed" />
      <Border Grid.Row="2" Grid.Column="2" Background="Transparent" Cursor="BottomRightCorner"
              Tag="SouthEast" PointerPressed="OnResizeGripPointerPressed" />
    </Grid>

  </Panel>
</Window>
