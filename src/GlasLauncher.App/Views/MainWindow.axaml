<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GlasLauncher.App.ViewModels"
        x:Class="GlasLauncher.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Glas Launcher"
        Width="1200" Height="760"
        CanResize="False"
        SystemDecorations="None"
        Background="{StaticResource BgDeepBrush}">

  <Panel>

    <!-- Custom titlebar + current page -->
    <DockPanel>
      <Border DockPanel.Dock="Top" Height="44" Background="{StaticResource BgPanelBrush}"
              BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" Margin="16,0,10,0">
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Content="Scénario : mods manquants"
                    Command="{Binding ToggleWorkshopScenarioCommand}"
                    FontSize="10.5" Padding="8,4" Margin="0,0,10,0"
                    Background="Transparent" Foreground="{StaticResource InkFaintBrush}" />
            <Button Content="–" Width="34" Height="30" Background="Transparent" Click="OnMinimizeClick" />
            <Button Content="✕" Width="34" Height="30" Background="Transparent" Click="OnCloseClick" />
          </StackPanel>
        </Grid>
      </Border>

      <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>

    <!-- Modal overlay -->
    <Panel IsVisible="{Binding CurrentModal, Converter={x:Static ObjectConverters.IsNotNull}}"
           Background="#B8040906">
      <ContentControl Content="{Binding CurrentModal}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>

  </Panel>
</Window>
