<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GlasLauncher.App.ViewModels"
             xmlns:conv="using:GlasLauncher.App.Converters"
             x:Class="GlasLauncher.App.Views.FirstRunView"
             x:DataType="vm:FirstRunViewModel">

  <UserControl.Resources>
    <conv:FirstRunStepToBadgeBrushConverter x:Key="FirstRunStepToBadgeBrushConverter" />
  </UserControl.Resources>

  <Grid Background="{StaticResource BgDeepBrush}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0" Width="460">

      <Image Source="avares://GlasLauncher.App/Assets/shield.png" Width="90" Height="74" HorizontalAlignment="Center" />

      <TextBlock Text="Bienvenue sur Glas Launcher" HorizontalAlignment="Center" Margin="0,20,0,0"
                 FontFamily="{StaticResource CinzelFont}" FontWeight="Bold" FontSize="26"
                 Foreground="{StaticResource GoldBrightBrush}" />

      <TextBlock Text="Préparation de votre installation avant votre première connexion à « Pour qui sonne le glas ». Cela ne prend qu'un instant."
                 HorizontalAlignment="Center" Margin="0,12,0,0"
                 Foreground="{StaticResource InkDimBrush}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" />

      <Border Margin="0,28,0,0" Background="{StaticResource BgPanel2Brush}" BorderBrush="{StaticResource LineSoftBrush}"
              BorderThickness="1" CornerRadius="10" Padding="26">
        <ItemsControl ItemsSource="{Binding Steps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FirstRunStepViewModel">
              <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Border Width="20" Height="20" CornerRadius="10"
                          Background="{Binding State, Converter={StaticResource FirstRunStepToBadgeBrushConverter}}">
                    <TextBlock Text="✓" Foreground="{StaticResource InkBrush}" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:FirstRunStepState.Done}}" />
                  </Border>
                  <TextBlock Text="{Binding Name}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold"
                             VerticalAlignment="Center" FontSize="14" />
                </StackPanel>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding PercentComplete}"
                             Height="4" CornerRadius="2" Margin="32,8,0,0"
                             Background="{StaticResource LineSoftBrush}" Foreground="{StaticResource GoldBrush}"
                             IsVisible="{Binding IsInProgress}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource WarnBrush}" FontSize="12"
                 HorizontalAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center"
                 IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <TextBlock Text="Vous n'aurez plus besoin de repasser par ces étapes aux prochains lancements."
                 HorizontalAlignment="Center" Margin="0,20,0,0"
                 Foreground="{StaticResource InkFaintBrush}" FontSize="12" />
    </StackPanel>
  </Grid>
</UserControl>
